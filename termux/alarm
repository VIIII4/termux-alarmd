#!/data/data/com.termux/files/usr/bin/bash
# alarm — alarmd root 模块的 Termux 侧 CLI
# 用法:
#   alarm set HH:MM [daily|workdays|weekend|once|1,3,5] [标签]
#   alarm list                 列出闹钟（标记下一次）
#   alarm rm <id>              删除
#   alarm snooze [分钟]        贪睡（默认 10 分钟）
#   alarm stop                 停止响铃
#   alarm kill                 紧急全停（守护/RTC/wakelock/声音/通知）
#   alarm test                 试铃（音量/通知/按钮）
#   alarm sound [路径]         查看/设置铃声（默认 /system/media/audio/alarms/Awoken.ogg）
#   alarm status               守护/RTC/下一次/log
#   alarm daemon start|stop|restart
set -u

D=/data/adb/alarmd
MOD=/data/adb/modules/alarmd
ALARMS=$D/alarms
RUN=$D/run

s() { su -c "$1"; }          # root 执行（读写 /data/adb 与 sysfs）
die() { echo "错误: $*" >&2; exit 1; }

daemon_alive() {
    local p
    p=$(s "cat '$RUN/alarmd.pid' 2>/dev/null")
    [ -n "$p" ] && s "kill -0 '$p' 2>/dev/null" >/dev/null 2>&1
}

check_daemon() {
    if ! daemon_alive; then
        echo "警告: alarmd 守护未运行，闹钟不会触发。执行: alarm daemon start" >&2
    fi
}

days_zh() {
    case "$1" in
        daily)    echo 每天 ;;
        workdays) echo 工作日 ;;
        weekend)  echo 周末 ;;
        once)     echo 单次 ;;
        xdaily)   echo 执行·每天 ;;
        xonce)    echo 执行·单次 ;;
        *)        echo "周$1" ;;
    esac
}

# ------------------------------------------------------------------ set --
cmd_set() {
    local t=$1; shift || true
    local days=once label id h m day0 now
    case "${1:-}" in
        daily|workdays|weekend|once) days=$1; shift ;;
        每天) days=daily; shift ;;
        工作日) days=workdays; shift ;;
        周末) days=weekend; shift ;;
        单次|一次) days=once; shift ;;
    esac
    if [ "$days" = once ] && [[ "${1:-}" =~ ^[1-7](,[1-7])*$ ]]; then
        days=$1; shift
    fi
    label=$(printf '%s ' "$@"); label=${label% }
    [[ "$t" =~ ^[0-9]{1,2}:[0-9]{1,2}$ ]] || die "时间格式: HH:MM"
    h=${t%%:*}; m=${t#*:}
    [ "$h" -le 23 ] && [ "$m" -le 59 ] || die "时间超出范围"
    t=$(printf '%02d:%02d' "$h" "$m")
    label=${label//|/／}; label=${label//\'/}

    id="a$(date +%H%M%S)"
    s "echo '$id|$t|$days|$label' >> '$ALARMS'" || die "写入失败（su 授权?）"
    echo "已添加: $t $(days_zh "$days") ${label:+「$label」}  (id=$id)"

    # 算下一次响给用户看（termux 的 GNU date 直接可用）
    now=$(date +%s)
    day0=$(date -d 'today 00:00' +%s)
    local e
    e=$(awk -F'|' -v id="$id" -v now="$now" -v day0="$day0" '
        $1 == id {
            if ($2 ~ /^[0-9]+$/) { print $2; exit }
            split($2, a, ":"); sod = a[1]*3600 + a[2]*60; spec = $3
            for (off = 0; off < 8; off++) {
                wd = (int(day0/86400) + 3 + off) % 7 + 1
                ok = 0
                if (spec == "daily" || spec == "once") ok = 1
                else if (spec == "workdays") ok = (wd <= 5)
                else if (spec == "weekend") ok = (wd >= 6)
                else if (spec ~ /^[0-9,]+$/) {
                    m2 = split(spec, L, ",")
                    for (i = 1; i <= m2; i++) if (L[i]+0 == wd) ok = 1
                }
                if (ok && day0 + off*86400 + sod > now) { print day0 + off*86400 + sod; exit }
            }
        }' <(s "cat '$ALARMS' 2>/dev/null"))
    [ -n "$e" ] && echo "下一次: $(date -d "@$e" '+%F %T %A')"
    check_daemon
}

# ----------------------------------------------------------------- list --
cmd_list() {
    local nextid line id t days label mark
    nextid=$(s "cut -d'|' -f1 '$RUN/next' 2>/dev/null")
    while IFS='|' read -r id t days label; do
        [ -z "${id:-}" ] && continue
        mark=""
        [ "$id" = "$nextid" ] && mark="  ← 下一次"
        printf '%s  %-9s %-6s %s%s\n' "$id" "$t" "$(days_zh "$days")" "$label" "$mark"
    done < <(s "cat '$ALARMS' 2>/dev/null")
    check_daemon
}

# ------------------------------------------------------------------- rm --
cmd_rm() {
    [ -n "${1:-}" ] || die "用法: alarm rm <id>（id 见 alarm list）"
    s "sed -i '/^$1|/d' '$ALARMS'" || die "删除失败"
    echo "已删除 $1"
}

# --------------------------------------------------------------- snooze --
cmd_snooze() {
    local n=${1:-10} e id
    [[ "$n" =~ ^[0-9]+$ ]] || die "分钟数无效"
    cmd_stop >/dev/null 2>&1
    e=$(( $(date +%s) + n * 60 ))
    id="s$(date +%s)"
    s "echo '$id|$e|once|贪睡' >> '$ALARMS'"
    echo "贪睡 $n 分钟（$(date -d "@$e" '+%H:%M') 响）"
    check_daemon
}

# ----------------------------------------------------------------- stop --
cmd_stop() {
    # 先取响铃 id 再 kill（kill 的 su 命令会删 firing，顺序反了通知就永远清不掉）
    local rp fid
    rp=$(s "cat '$RUN/ring.pid' 2>/dev/null")
    fid=$(s "cat '$RUN/firing' 2>/dev/null")
    [ -n "$rp" ] && s "kill '$rp' 2>/dev/null; rm -f '$RUN/ring.pid' '$RUN/firing'"
    s "touch '$RUN/stop'" 2>/dev/null
    termux-media-player stop >/dev/null 2>&1
    local fid
    fid=$(s "cat '$RUN/firing' 2>/dev/null")
    [ -n "$fid" ] && termux-notification-remove "alarm-$fid" >/dev/null 2>&1
    termux-notification-remove alarm-test >/dev/null 2>&1
    # 兜底：清掉一切 alarm- 开头的残留响铃通知（需通知使用权权限）
    timeout 8 termux-notification-list 2>/dev/null \
        | grep -o '"tag": "alarm-[^"]*"' \
        | sed 's/"tag": "//; s/"$//' \
        | while read -r t; do termux-notification-remove "$t" >/dev/null 2>&1; done
    echo "已停止"
}

# ----------------------------------------------------------------- test --
cmd_test() {
    local snd
    snd=$(s "grep '^SOUND=' '$D/config' 2>/dev/null | cut -d= -f2")
    snd=${snd:-/system/media/audio/alarms/Awoken.ogg}
    echo "试铃: $snd（30 秒后自动停，或点通知按钮 / alarm stop）"
    termux-volume alarm 8 >/dev/null 2>&1
    termux-volume music 6 >/dev/null 2>&1
    termux-notification --id alarm-test --title "⏰ 试铃" \
        --content "alarm stop 停止 · alarm snooze 贪睡" \
        --priority max --ongoing \
        --button1 停止 --button1-action "alarm stop" \
        --button2 贪睡10分 --button2-action "alarm snooze 10" \
        --on-delete "alarm stop" >/dev/null 2>&1
    termux-media-player play "$snd" >/dev/null 2>&1
    # 30s 后自动收尾；期间可用通知按钮或 alarm stop 停
    sleep 30
    termux-media-player stop >/dev/null 2>&1
    termux-notification-remove alarm-test >/dev/null 2>&1
}

# ---------------------------------------------------------------- sound --
cmd_sound() {
    if [ -z "${1:-}" ]; then
        s "grep -E '^(SOUND|RING_MAX)=' '$D/config' 2>/dev/null" || \
            echo "SOUND=/system/media/audio/alarms/Awoken.ogg"
        echo "可选: $(ls /system/media/audio/alarms/ 2>/dev/null | head -20 | tr '\n' ' ')"
    else
        [ -f "$1" ] || die "文件不存在: $1"
        if s "grep -q '^SOUND=' '$D/config'"; then
            s "sed -i 's|^SOUND=.*|SOUND=$1|' '$D/config'"
        else
            s "echo 'SOUND=$1' >> '$D/config'"
        fi
        echo "铃声已设为: $1"
    fi
}

# -------------------------------------------------------------- kill ----
cmd_kill() {
    s "pkill -9 -f 'alarmd[.]sh' 2>/dev/null; echo 0 > /sys/class/rtc/rtc0/wakealarm 2>/dev/null; echo alarmd > /sys/power/wake_unlock 2>/dev/null; true"
    termux-media-player stop >/dev/null 2>&1
    local n
    for n in $(s "cat '$RUN/firing' 2>/dev/null"); do termux-notification-remove "alarm-$n" >/dev/null 2>&1; done
    termux-notification-remove alarm-test >/dev/null 2>&1
    echo "已全部强停（守护/响铃/RTC/wakelock/声音/通知）"
}

# --------------------------------------------------------------- status --
cmd_status() {
    local p rtc n
    if daemon_alive; then
        p=$(s "cat '$RUN/alarmd.pid'")
        echo "守护:   运行中 (pid $p)"
    else
        echo "守护:   未运行 ← alarm daemon start"
    fi
    rtc=$(s "cat /sys/class/rtc/rtc0/wakealarm")
    if [ "${rtc:-0}" != "0" ] && [ -n "${rtc:-}" ]; then
        echo "RTC:    已设 $(date -d "@$rtc" '+%F %T')"
    else
        echo "RTC:    未设"
    fi
    n=$(s "cat '$RUN/next' 2>/dev/null")
    if [ -n "$n" ]; then
        local id e rest days label
        id=${n%%|*}; rest=${n#*|}; e=${rest%%|*}; rest=${rest#*|}
        days=${rest%%|*}; label=${rest#*|}
        echo "下一次: $(date -d "@$e" '+%F %T %A') [$id] $(days_zh "$days") $label"
    else
        echo "下一次: (无闹钟)"
    fi
    echo "-- log 尾部 --"
    s "tail -n 6 '$D/log' 2>/dev/null"
}

# -------------------------------------------------------------- daemon ---
cmd_daemon() {
    local op=${1:-status}
    case "$op" in
        start)
            daemon_alive && { echo "已在运行 (pid $(s "cat '$RUN/alarmd.pid'"))"; exit 0; }
            s "nohup /system/bin/sh '$MOD/alarmd.sh' >/dev/null 2>&1 &"
            # su 拉起有延迟，轮询最多 10s
            for i in $(seq 1 10); do
                daemon_alive && { echo "已启动 (pid $(s "cat '$RUN/alarmd.pid'"))"; exit 0; }
                sleep 1
            done
            die "启动失败，看 /data/adb/alarmd/log"
            ;;
        stop)
            s "kill \$(cat '$RUN/alarmd.pid') 2>/dev/null"
            for i in $(seq 1 10); do daemon_alive || break; sleep 1; done
            daemon_alive && die "停止超时（可能 su 延迟，稍后用 alarm status 确认）" || echo "已停止"
            ;;
        restart)
            cmd_daemon stop >/dev/null 2>&1
            sleep 1
            cmd_daemon start
            ;;
        status)
            daemon_alive && echo running || echo dead
            ;;
        *) die "用法: alarm daemon start|stop|restart|status" ;;
    esac
}

case "${1:-help}" in
    set)    shift; [ -n "${1:-}" ] || die "用法: alarm set HH:MM [days] [标签]"; cmd_set "$@" ;;
    list|ls) cmd_list ;;
    rm|del)  shift; cmd_rm "$@" ;;
    snooze)  shift; cmd_snooze "$@" ;;
    stop)    cmd_stop ;;
    kill)    cmd_kill ;;
    test)    cmd_test ;;
    sound)   shift; cmd_sound "$@" ;;
    status)  cmd_status ;;
    daemon)  shift; cmd_daemon "$@" ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
